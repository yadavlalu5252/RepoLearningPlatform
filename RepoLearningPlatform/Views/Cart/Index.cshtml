@model List<RepoLearningPlatform.Models.Cart>

@{
    ViewData["Title"] = "Cart";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Cart</h2>

        <a asp-controller="AllCourses"
           asp-action="Index"
           class="btn btn-primary">
            Continue Shopping
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card shadow h-100">

                        @if (item.MasterCourseId != null)
                        {
                            <img src="@item.MasterCourseData.Thumbnail"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover;"
                                 alt="@item.MasterCourseData.MasterCourseName">

                            <div class="card-body">

                                <h5 class="card-title">
                                    @item.MasterCourseData.MasterCourseName
                                </h5>

                                <span class="badge bg-primary">
                                    Master Course
                                </span>

                                <p class="mt-3">
                                    <strong>Amount:</strong>
                                    ₹@item.Amount
                                </p>

                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.CartId" />

                                    <button type="submit"
                                            class="btn btn-danger w-100">
                                        Remove
                                    </button>

                                </form>

                            </div>
                        }

                        @if (item.SubCourseId != null)
                        {
                            <img src="@item.SubCourseData.Thumbnail"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover;"
                                 alt="@item.SubCourseData.SubCourseName">

                            <div class="card-body">

                                <h5 class="card-title">
                                    @item.SubCourseData.SubCourseName
                                </h5>

                                <span class="badge bg-success">
                                    Sub Course
                                </span>

                                <p class="mt-3">
                                    <strong>Amount:</strong>
                                    ₹@item.Amount
                                </p>

                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.CartId" />

                                    <button type="submit"
                                            class="btn btn-danger w-100">
                                        Remove
                                    </button>

                                </form>

                            </div>
                        }

                        @if (item.SubscriptionId != null)
                        {
                            <img src="@item.SubscriptionData.Thumbnail"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover;"
                                 alt="@item.SubscriptionData.stype">

                            <div class="card-body">

                                <h5 class="card-title">
                                    @item.SubscriptionData.stype
                                </h5>

                                <span class="badge bg-warning text-dark">
                                    Subscription
                                </span>

                                <p class="mt-3">
                                    <strong>Amount:</strong>
                                    ₹@item.Amount
                                </p>

                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.CartId" />

                                    <button type="submit"
                                            class="btn btn-danger w-100">
                                        Remove
                                    </button>

                                </form>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

        <div class="d-flex justify-content-end mt-3 mb-4">
            <div class="text-end">

                <h4 class="mb-3">
                    Total:
                    ₹@Model.Sum(x => x.Amount)
                </h4>

                <a asp-controller="Cart"
                   asp-action="Checkout"
                   class="btn btn-success">
                    Proceed to Checkout
                </a>

            </div>
        </div>
    }
</div>