@{
    ViewData["Title"] = "All Courses";

    var masterCourses = ViewBag.MasterCourses
        as List<RepoLearningPlatform.Models.MasterCourse>;

    var subCourses = ViewBag.SubCourses
        as List<RepoLearningPlatform.Models.SubCourse>;

    var subscriptions = ViewBag.Subscriptions
        as List<RepoLearningPlatform.Models.Subscription>;
}

<div class="container mt-4">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>All Courses</h2>

        <a asp-controller="Cart"
           asp-action="Index"
           class="btn btn-primary">
            🛒 Cart
        </a>

    </div>


    <!-- Filters -->

    <div class="mb-4">

        <div class="form-check form-check-inline">

            <input class="form-check-input course-filter"
                   type="checkbox"
                   value="master"
                   id="masterFilter">

            <label class="form-check-label" for="masterFilter">
                Master Course
            </label>

        </div>


        <div class="form-check form-check-inline">

            <input class="form-check-input course-filter"
                   type="checkbox"
                   value="sub"
                   id="subFilter">

            <label class="form-check-label" for="subFilter">
                Sub Course
            </label>

        </div>


        <div class="form-check form-check-inline">

            <input class="form-check-input course-filter"
                   type="checkbox"
                   value="subscription"
                   id="subscriptionFilter">

            <label class="form-check-label" for="subscriptionFilter">
                Subscription
            </label>

        </div>

    </div>


    <!-- Course Cards -->

    <div class="row">


        <!-- Master Courses -->
        @foreach (var item in masterCourses)
        {
            <div class="col-lg-4 col-md-6 mb-4 course-card"
                 data-type="master">

                <div class="card shadow h-100">

                    <img src="@item.Thumbnail"
                         class="card-img-top"
                         style="height:200px; object-fit:cover;"
                         alt="@item.MasterCourseName">


                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @item.MasterCourseName
                        </h5>


                        <span class="badge bg-primary align-self-start mb-3">
                            Master Course
                        </span>


                        <p class="mb-3">
                            <strong>Amount:</strong>
                            ₹@ViewBag.MasterCourseAmounts[item.Id]
                        </p>


                        <form asp-controller="Cart"
                              asp-action="AddMasterCourse"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                🛒 Add to Cart
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }


        <!-- Sub Courses -->
        @foreach (var item in subCourses)
        {
            <div class="col-lg-4 col-md-6 mb-4 course-card"
                 data-type="sub">

                <div class="card shadow h-100">

                    <img src="@item.Thumbnail"
                         class="card-img-top"
                         style="height:200px; object-fit:cover;"
                         alt="@item.SubCourseName">


                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @item.SubCourseName
                        </h5>


                        <span class="badge bg-success align-self-start mb-3">
                            Sub Course
                        </span>


                        <p class="mb-3">
                            <strong>Amount:</strong>
                            ₹@item.Amount
                        </p>


                        <form asp-controller="Cart"
                              asp-action="AddSubCourse"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-success w-100">
                                🛒 Add to Cart
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }


        <!-- Subscriptions -->
        @foreach (var item in subscriptions)
        {
            <div class="col-lg-4 col-md-6 mb-4 course-card"
                 data-type="subscription">

                <div class="card shadow h-100">

                    <img src="@item.Thumbnail"
                         class="card-img-top"
                         style="height:200px; object-fit:cover;"
                         alt="@item.stype">


                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @item.stype
                        </h5>


                        <span class="badge bg-warning text-dark align-self-start mb-3">
                            Subscription
                        </span>


                        <p class="mb-3">
                            <strong>Amount:</strong>
                            ₹@item.amount
                        </p>


                        <form asp-controller="Cart"
                              asp-action="AddSubscription"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.sid" />

                            <button type="submit"
                                    class="btn btn-warning w-100">
                                🛒 Add to Cart
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>

</div>


<script>

    document.querySelectorAll(".course-filter").forEach(function (checkbox) {

        checkbox.addEventListener("change", function () {

            var selectedType = this.value;

            if (this.checked) {

                document.querySelectorAll(".course-filter").forEach(function (item) {

                    if (item != checkbox) {
                        item.checked = false;
                    }

                });


                document.querySelectorAll(".course-card").forEach(function (card) {

                    if (card.getAttribute("data-type") == selectedType) {

                        card.style.display = "block";

                    }
                    else {

                        card.style.display = "none";

                    }

                });

            }
            else {

                document.querySelectorAll(".course-card").forEach(function (card) {

                    card.style.display = "block";

                });

            }

        });

    });

</script>